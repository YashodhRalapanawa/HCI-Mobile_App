# Copy this file to `.env` (same folder). Never commit `.env`.
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone — NO secrets here.
# MongoDB credentials and other server secrets belong only in backend/.env.

# Backend API base URL, INCLUDING the /api suffix.
#   Physical phone (Expo Go):  http://<your-computer-LAN-IP>:5000/api   e.g. http://192.168.1.20:5000/api
#   Android emulator:          http://10.0.2.2:5000/api
#   iOS simulator / web:       http://localhost:5000/api
# The phone/emulator must be able to reach the backend over the network (same Wi-Fi,
# firewall allows port 5000). `npx expo start --tunnel` only tunnels Metro, NOT the backend.
EXPO_PUBLIC_API_URL=http://localhost:5000/api

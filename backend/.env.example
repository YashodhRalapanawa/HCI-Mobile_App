# Copy this file to `.env` (same folder) and fill in real values.
# Never commit `.env`. Never put these values in the frontend.

NODE_ENV=development
PORT=5000

# Leave empty to run the API without a database (scaffold mode; /api/ready returns 503).
# Local:   mongodb://127.0.0.1:27017/blood_donor_dev
# Atlas:   mongodb+srv://<user>:<password>@<cluster-host>/blood_donor_dev?retryWrites=true&w=majority
MONGODB_URI=
